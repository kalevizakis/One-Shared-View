{
    // ── ESSENCE Dev Team — Recommended VS Code Settings ──────────────────────
    // Copy the settings you want into your own User settings.json.
    // Open it via: Ctrl+Shift+P → "Open User Settings (JSON)"
    //
    // These settings reduce background token spend from the Copilot inline
    // completions engine (Panel/Edit Agent), which fires independently of the
    // ESSENCE chat agent and can account for 40%+ of billable tokens.
    // ─────────────────────────────────────────────────────────────────────────
    // ── 1. Disable inline completions for config/doc file types ──────────────
    // Copilot fires a completion request on every typing pause, even in
    // markdown and JSON files. Disabling these file types eliminates those
    // calls entirely. Code files (*.py, *.ts, *.js, etc.) remain active.
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "json": false,
        "jsonc": false,
        "yaml": false,
        "toml": false,
        "scminput": false
    },
    // ── 2. Increase quick-suggestion delay ───────────────────────────────────
    // Default is ~10ms — fires immediately after any keypress.
    // 500ms means Copilot waits until you've paused typing, cutting accidental
    // mid-word triggers. Applies to all enabled file types.
    "editor.quickSuggestionsDelay": 500,
    // ── 3. Show inline toolbar only on hover ─────────────────────────────────
    // Cosmetic. The accept/next/dismiss buttons appear only when you hover the
    // grey ghost text instead of always being visible. No token impact.
    "editor.inlineSuggest.showToolbar": "onHover",
    // ── 4. Disable the background TODO agent ───────────────────────────────
    // Scans open files for TODO/FIXME comments automatically, even when idle.
    // Measured at ~1.2M tokens/day (14% of billable spend) with no active use.
    // If you track tasks via ESSENCE sessions + Chronicle, this is pure waste.
    "github.copilot.chat.agent.backgroundTodoAgent.enabled": false,
    // ── Note on completions model ─────────────────────────────────────────────
    // There is currently no JSON setting to control the inline completions model.
    // Switch it via the UI: Settings → Copilot → Completion Model → GPT-4o Mini.
    // GPT-4o Mini is 15-20x cheaper than Opus for inline completions.
}