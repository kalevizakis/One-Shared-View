#!/bin/sh
# ESSENCE pre-commit gate. Runs tools/release_check.ps1 (falling back to
# tools/release_check.sh when neither pwsh nor powershell.exe is available)
# only when the commit touches a linted surface (agent/, references/,
# SKILL.md, skill.json, docs/ARCHITECTURE.md) — keeps unrelated commits fast.
#
# One-time install (this file is NOT auto-installed by git clone):
#   copy tools\hooks\pre-commit .git\hooks\pre-commit   (Windows)
#   cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit   (POSIX)

watched='^(agent/|references/|SKILL\.md$|skill\.json$|docs/ARCHITECTURE\.md$)'

if git diff --cached --name-only | grep -E "$watched" > /dev/null; then
    echo "essence pre-commit: linted surface touched, running release_check..."
    if command -v pwsh >/dev/null 2>&1; then
        pwsh -NoProfile -File tools/release_check.ps1
    elif command -v powershell.exe >/dev/null 2>&1; then
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/release_check.ps1
    else
        sh tools/release_check.sh
    fi
    exit $?
fi

exit 0
